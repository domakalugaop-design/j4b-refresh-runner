# Public-safe configuration template.
# NEVER put real values in this file.

# Portal source (real values belong in GitHub Actions Secrets)
PORTAL_BASE_URL=https://example.invalid
PORTAL_LOGIN=replace-me
PORTAL_PASSWORD=replace-me
PORTAL_REQUEST_DELAY=0.15

# Google OAuth refresh-token flow (Secrets)
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REFRESH_TOKEN=replace-me

# Isolated TEST target (Secret)
GOOGLE_SPREADSHEET_ID=replace-me
GOOGLE_WORKSHEET=projects_current

# Runtime
RUN_MODE=test
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# Qualification safety guard: production mode must remain disabled until explicit cutover.
ALLOW_PRODUCTION_WRITE=false
