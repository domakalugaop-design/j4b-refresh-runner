# Public-safe configuration template.
# NEVER put real values in this file.

# Source system
SOURCE_BASE_URL=https://example.invalid
SOURCE_AUTH_MODE=replace-me
SOURCE_TOKEN=replace-me

# Google target
GOOGLE_SPREADSHEET_ID=replace-me
GOOGLE_WORKSHEET=projects_current
GOOGLE_CREDENTIALS_JSON=replace-me

# Runtime
RUN_MODE=test
