CONTROLLER_QUALITY_PUBLICATION_ENABLED=false
PORTAL_CREDENTIALS_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON_FILE=/home/maxis/j4b-refresh-deployment/credentials/google-service-account.json
J4B_SHARED_LOCK_PATH=/home/maxis/j4b-refresh-deployment/locks/production.lock
